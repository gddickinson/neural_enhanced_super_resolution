{
 "size": 256,
 "factors": [
  2,
  4
 ],
 "patterns": [
  {
   "id": "zone_plate",
   "title": "Zone plate",
   "description": "Circular zone plate: every spatial frequency up to Nyquist; aliasing shows as moire rings."
  },
  {
   "id": "siemens_star",
   "title": "Siemens star",
   "description": "36 black and white wedges that get finer towards the centre."
  },
  {
   "id": "bar_chart",
   "title": "Resolution bars",
   "description": "Groups of three bars with periods from 12 px down to 2 px, both orientations."
  },
  {
   "id": "color_shapes",
   "title": "Colour shapes",
   "description": "Discs, a rotated square and thin lines on a smooth gradient."
  }
 ],
 "methods": [
  {
   "id": "nearest",
   "label": "Nearest neighbour",
   "kind": "classical",
   "description": "Each low-resolution pixel becomes a block: shows exactly what the input contains.",
   "browser": true,
   "short": "Nearest"
  },
  {
   "id": "bicubic",
   "label": "Bicubic",
   "kind": "classical",
   "description": "cv2.resize INTER_CUBIC (a = -0.75), the pipeline's own fallback when no model loads.",
   "browser": true,
   "short": "Bicubic"
  },
  {
   "id": "lanczos",
   "label": "Lanczos-4",
   "kind": "classical",
   "description": "cv2.resize INTER_LANCZOS4 (8x8 windowed sinc), used by the pipeline to align ensemble members.",
   "browser": true,
   "short": "Lanczos"
  },
  {
   "id": "nesr_basic",
   "label": "NESR pipeline, no neural models",
   "kind": "pipeline",
   "description": "enhance_image with all models off: denoise + CLAHE, bicubic x2 per iteration, adaptive sharpening.",
   "browser": false,
   "short": "NESR basic"
  },
  {
   "id": "realesrgan",
   "label": "Real-ESRGAN x2plus",
   "kind": "model",
   "description": "The pipeline's Real-ESRGAN step alone (RealESRGAN_x2plus.pth, committed in models/weights), applied once per x2.",
   "browser": false,
   "short": "Real-ESRGAN"
  },
  {
   "id": "nesr_esrgan",
   "label": "NESR pipeline with Real-ESRGAN",
   "kind": "pipeline",
   "description": "enhance_image with Real-ESRGAN: denoise + CLAHE, Real-ESRGAN x2, adaptive sharpening, per iteration.",
   "browser": false,
   "short": "NESR + ESRGAN"
  }
 ],
